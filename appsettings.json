{
  "ConnectionStrings": {
    "AzureBlobStorage": "REPLACE_WITH_REAL_CONNECTION_STRING_ON_DEPLOY_TARGET"
  },
  "Storage": {
    "Azure": {
      "ContainerName": "autoreport",
      "ScriptContainerName": "radet-sql",
      "BlobPrefixes": {
        "RADET": "RADET",
        "HTS": "HTS"
      },
      "DownloadMaxRetryAttempts": 3,
      "DownloadRetryDelaySeconds": 5,
      "DownloadTimeoutSeconds": 300,
      "TempDownloadPath": "C:\\Reports\\Staging",
      "CleanStagingAfterDeploy": true
    }
  },
  "Heartbeat": {
    "TableName": "FacilityHeartbeat",
    "IntervalMinutes": 5,
    "OfflineThresholdMinutes": 12,
    "WriteTimeoutSeconds": 10,
    "MaxRetryAttempts": 10
  },
  "Database": {
    "ConnectionString": "REPLACE_WITH_REAL_CONNECTION_STRING_ON_DEPLOY_TARGET",
    "CommandTimeoutSeconds": 3600,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2
  },
  "Auth": {
    "Enabled": false,
    "LicenseKey": "YOUR_LICENSE_KEY_HERE",
    "ValidationEndpoint": "https://baycentral.ahnigeria.org.ng/api/addon/verify-serial",
    "LicenseTier": "Enterprise",
    "RequestTimeoutSeconds": 60,
    "EnableDailyCache": true,
    "BlockedCacheMinutes": 10,
    "CachePath": "",
    "MaxRetryAttempts": 10,
    "PermitWhenInconclusive": true
  },
  "Reports": {
    "CronSchedule": "0 4 * * *",
    "CronSchedules": [
      "0 4 * * *",
      "1 6 * * *",
      "1 8 * * *",
      "1 10 * * *",
      "1 12 * * *",
      "1 14 * * *",
      "1 16 * * *",
      "1 18 * * *"
    ],
    "RunOnStartup": true,
    "AllowOffScheduleStartupRun": true,
    "EnableCycleAudit": true,
    "CycleAuditPath": "",
    "TimeZoneId": "Africa/Lagos",
    "GlobalCycleTimeoutSeconds": 3600,
    "DefaultScriptTimeoutSeconds": 1200,
    "MaxParallelScripts": 2,
    // RADET is the only report script. It writes one workbook per cycle; the other entries are
    // its sheets 2-7 and only set where each sheet's SQL lives (BlobPath, in the radet-sql blob
    // container) and whether the sheet is filled (Enabled=false leaves it empty). Every script is
    // downloaded from blob storage each cycle; there is no local copy.
    "Scripts": [
      {
        // Sheet 1 - RADET. Its dates, FacilityId and TimeoutSeconds apply to the whole workbook.
        "Name": "RADET",
        "BlobPath": "radet_query_new.sql",
        "Enabled": true,
        "FacilityId": 0,
        "TimeoutSeconds": 1200,
        "StartDate": "",
        "EndDate": ""
      },
      { // Sheet 2
        "Name": "HTS",
        "BlobPath": "hts.sql",
        "Enabled": true
      },
      { // Sheet 3
        "Name": "Index",
        "BlobPath": "index_report.sql",
        "Enabled": true
      },
      { // Sheet 4
        "Name": "PMTCTHTS",
        "BlobPath": "pmtct_hts_report.sql",
        "Enabled": true
      },
      { // Sheet 5
        "Name": "Maternal",
        "BlobPath": "maternal_cohort_report.sql",
        "Enabled": true
      },
      { // Sheet 6
        "Name": "Prep",
        "BlobPath": "prep_query.sql",
        "Enabled": true
      },
      { // Sheet 7
        "Name": "AHD",
        "BlobPath": "ahd_query_raw.sql",
        "Enabled": true
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}

