{
  "StorageProvider": "Azure",
  "ConnectionStrings": {
    "AzureBlobStorage": "REPLACE_WITH_REAL_CONNECTION_STRING_ON_DEPLOY_TARGET"
  },
  "Storage": {
    "Azure": {
      "ContainerName": "autoreport",
      "ScriptContainerName": "radet-sql",
      "LocalScriptPath": "Scripts",
      "BlobPrefixes": {
        "RADET": "RADET",
        "HTS": "HTS"
      },
      "DownloadMaxRetryAttempts": 3,
      "DownloadRetryDelaySeconds": 5,
      "DownloadTimeoutSeconds": 300,
      "TempDownloadPath": "C:\\Reports\\Staging",
      "CleanStagingAfterDeploy": true
    },
    "Local": {
      "ScriptPath": "Scripts",
      "OutputPath": "C:\\Reports\\Output"
    }
  },
  "Heartbeat": {
    "TableName": "FacilityHeartbeat",
    "IntervalMinutes": 5,
    "OfflineThresholdMinutes": 12,
    "WriteTimeoutSeconds": 10,
    "MaxRetryAttempts": 10
  },
  "Database": {
    "ConnectionString": "REPLACE_WITH_REAL_CONNECTION_STRING_ON_DEPLOY_TARGET",
    "CommandTimeoutSeconds": 3600,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2
  },
  "Auth": {
    "Enabled": false,
    "LicenseKey": "YOUR_LICENSE_KEY_HERE",
    "ValidationEndpoint": "https://baycentral.ahnigeria.org.ng/api/addon/verify-serial",
    "LicenseTier": "Enterprise",
    "RequestTimeoutSeconds": 60,
    "EnableDailyCache": true,
    "BlockedCacheMinutes": 10,
    "CachePath": "",
    "MaxRetryAttempts": 10,
    "PermitWhenInconclusive": true
  },
  "Reports": {
    "CronSchedule": "0 4 * * *",
    "CronSchedules": [
      "0 4 * * *",
      "1 6 * * *",
      "1 8 * * *",
      "1 10 * * *",
      "1 12 * * *",
      "1 14 * * *",
      "1 16 * * *",
      "1 18 * * *"
    ],
    "RunOnStartup": true,
    "AllowOffScheduleStartupRun": true,
    "EnableCycleAudit": true,
    "CycleAuditPath": "",
    "TimeZoneId": "Africa/Lagos",
    "GlobalCycleTimeoutSeconds": 3600,
    "DefaultScriptTimeoutSeconds": 1200,
    "MaxParallelScripts": 2,
    "Scripts": [
      {
