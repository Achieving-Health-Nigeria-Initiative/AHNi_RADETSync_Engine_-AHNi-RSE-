{
  "ConnectionStrings": {
    "AzureBlobStorage": "REPLACE_WITH_REAL_CONNECTION_STRING_ON_DEPLOY_TARGET"
  },
  "Storage": {
    "Azure": {
      "ContainerName": "autoreport",          // gen-pop facilities
      "CareContainerName": "community-center", // community centres (see the Facility section)
      "ScriptContainerName": "autoreport",
      "BlobPrefixes": {
        // The workbook's folder is Reports:WorkbookFolder (set in code: TEST-RADET for now), not this map.
        "RAW-REPORT": "raw-report"           // force backfills of report type "raw" (Parquet files)
      },
      "DownloadMaxRetryAttempts": 3,
      "DownloadRetryDelaySeconds": 5,
      "DownloadTimeoutSeconds": 300,
      "TempDownloadPath": "C:\\Reports\\Staging"
    }
  },
  "Heartbeat": {
    "TableName": "FacilityHeartbeat",
    "IntervalMinutes": 5,
    "OfflineThresholdMinutes": 12,
    "WriteTimeoutSeconds": 10,
    "MaxRetryAttempts": 10
  },
  // RADET backfills requested in BayCentral (Administration -> Force Backfill). The service checks the
  // ForceBackfillJobs table for this facility's pending jobs every PollMinutes and runs them one at a time,
  // each as of its date, uploading to <Reports:WorkbookFolder>/<date>/ (TEST-RADET for now). RunAlongsideSchedule=false stops a backfill from
  // overlapping a scheduled cycle (set it on PCs too slow to run two at once).
  "ForceBackfill": {
    "Enabled": true,
    "TableName": "ForceBackfillJobs",
    "PollMinutes": 5,
    "RunAlongsideSchedule": true,
    "MaxAttempts": 3
  },
  // Custom SQL: force backfill jobs of report type "custom" run a script uploaded in the Backfill app, read-only
  // (one SELECT/WITH query in a READ ONLY transaction that is rolled back), and upload the result as Parquet to
  // <Container>/<script>/<request>/<Facility>_<DATIM>.parquet. TimeoutSeconds stops the query; a result with more
  // than MaxRows rows fails the job. Facilities without this section use these same defaults.
  "CustomScript": {
    "Enabled": true,
    "Container": "custom-reports",
    "TimeoutSeconds": 900,
    "MaxRows": 2000000
  },
  // Auto-update: every CheckMinutes the service reads <Container>/<Folder>/manifest.json (empty Container =
  // ScriptContainerName, i.e. autoreport/rse-release/manifest.json) and, when it names a newer version for this
  // facility, downloads AHNiRSE-<version>.exe, checks its SHA-256 and installs it between report runs, putting the
  // previous version back if the new one doesn't keep running. Only the exe is replaced, never this file.
  // Releases are published and managed in the Backfill app (RSE release tab), or with deploy\Build-Release.ps1
  // -Publish and deploy\Manage-Update.ps1.
  "AutoUpdate": {
    "Enabled": true,
    "Container": "",
    "Folder": "rse-release",
    "CheckMinutes": 5,
    "SpreadMinutes": 10,
    "QuietMinutesBeforeSchedule": 10,
    "HealthCheckMinutes": 5
  },
  "Database": {
    "ConnectionString": "REPLACE_WITH_REAL_CONNECTION_STRING_ON_DEPLOY_TARGET",
    "CommandTimeoutSeconds": 3600,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2
  },
  // This facility: community centre (true) or gen-pop (false). Restart the service after changing it.
  //   Community centre -> container community-center, file <facility>_<DATIM>_<date>, without CareExcludedSheets.
  //   Gen-pop          -> container autoreport, file <facility>_<date>, all sheets.
  "Facility": {
    "IsCommunityCentre": false,
    // Reports:Scripts names left out of community-centre workbooks and raw reports. [ "none" ] = keep every sheet.
    "CareExcludedSheets": [ "PMTCTHTS", "Maternal" ]
  },
  "Auth": {
    "Enabled": false,
    "LicenseKey": "YOUR_LICENSE_KEY_HERE",
    "ValidationEndpoint": "https://baycentral.ahnigeria.org.ng/api/addon/verify-serial",
    "LicenseTier": "Enterprise",
    "RequestTimeoutSeconds": 60,
    "EnableDailyCache": true,
    "BlockedCacheMinutes": 10,
    "CachePath": "",
    "PermitWhenInconclusive": true
  },
  "Reports": {
    "CronSchedule": "0 4 * * *",
    "CronSchedules": [
      "0 4 * * *",
      "1 6 * * *",
      "1 8 * * *",
      "1 10 * * *",
      "1 12 * * *",
      "1 14 * * *",
      "1 16 * * *",
      "1 18 * * *"
    ],
    "RunOnStartup": true,
    "AllowOffScheduleStartupRun": true,
    "EnableCycleAudit": true,
    "CycleAuditPath": "",
    "TimeZoneId": "Africa/Lagos",
    // Workbook file names (without .xlsx): gen-pop / community centre (see the Facility section).
    "FileNameFormat": "{facility}_{datim}_{date}",
    "CareFileNameFormat": "{facility}_{datim}_{date}",
    "GlobalCycleTimeoutSeconds": 3600,
    "DefaultScriptTimeoutSeconds": 1200,
    // RADET is the only report script. It writes one workbook per cycle; the other entries are
    // its sheets 2-7. Each entry sets where its SQL lives - BlobPath, in the script container
    // (Storage:Azure:ScriptContainerName = autoreport, folder report-script/) - and whether the sheet is
    // filled (Enabled=false leaves it with headers only). Scripts are downloaded every cycle.
    //
    // Every sheet uses a LAMISPlus report module query. RADET has named placeholders;
    // the others are the module's queries unchanged (ReportRepository native queries with ?1..?3, and
    // query.yml queries - app\query.yml, released 2026-09-18 - with '?1'..'?4'). Bound as:
    //   :facility_id / ?1   FacilityId, or 0 = SELECT current_organisation_unit_id FROM base_application_user WHERE id = 1
    //   :start_date  / ?2   StartDate (yyyy-MM-dd), or the script's default worked out from the end date:
    //                       RADET 1980-01-01; HTS 1 July before the fiscal year (1 Oct - 30 Sep) that
    //                       contains the end date, e.g. EndDate 2025-09-30 -> 2024-07-01
    //   :end_date    / ?3   EndDate (yyyy-MM-dd), or today (WAT); a force backfill always uses its own date
    //   :previous_quarter_end, :previous_previous_quarter_end   worked out from the end date (RADET)
    // The HTS sheet keeps only the 29 columns it has always had; the module's other HTS columns are not written.
    // The Index sheet keeps the 18 headers of the earlier blob index_report.sql; those the module's HTS Index
    // report has no column for (index client Age and Sex, Type of contact, HIV Test Status) are left empty.
    "Scripts": [
      {
        // Sheet 1 - RADET. Its FacilityId and TimeoutSeconds apply to the whole workbook.
        "Name": "RADET",
        "BlobPath": "report-script/radet.sql",
        "Enabled": true,
        "FacilityId": 0,
        "TimeoutSeconds": 1200,
        "StartDate": "",
        "EndDate": ""
      },
      { // Sheet 2
        "Name": "HTS",
        "BlobPath": "report-script/hts.sql",
        "Enabled": true,
        "StartDate": "",
        "EndDate": ""
      },
      { // Sheet 3 - report module HTS Index (family index / ICT), ?1 only: always every record, no dates
        "Name": "Index",
        "BlobPath": "report-script/index.sql",
        "Enabled": true
      },
      { // Sheet 4 - report module PMTCT HTS (Pepfar), ?1..?3; StartDate default 1980-01-01
        "Name": "PMTCTHTS",
        "BlobPath": "report-script/pmtct_hts.sql",
        "Enabled": true,
        "StartDate": "",
        "EndDate": ""
      },
      { // Sheet 5 - report module query.yml maternal cohort, '?1'..'?3'; StartDate default 1980-01-01
        "Name": "Maternal",
        "BlobPath": "report-script/maternal.sql",
        "Enabled": true,
        "StartDate": "",
        "EndDate": ""
      },
      { // Sheet 6 - report module query.yml prep-query, '?1'..'?3'; StartDate default 1980-01-01
        "Name": "Prep",
        "BlobPath": "report-script/prep.sql",
        "Enabled": true,
        "StartDate": "",
        "EndDate": ""
      },
      { // Sheet 7 - report module query.yml ahd-query, '?1'..'?4' (?4 = previous quarter end); StartDate default 1980-01-01
        "Name": "AHD",
        "BlobPath": "report-script/ahd.sql",
        "Enabled": true,
        "StartDate": "",
        "EndDate": ""
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}

